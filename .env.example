# Database URL - SQLite for out-of-the-box local execution.
# To connect to PostgreSQL (e.g. Neon, Somee.com), replace with:
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./travel_assistant.db

# Authentication
JWT_SECRET=4f738a9b2b3a1a9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ollama RAG Server (Docker or Local Installation)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=tinyllama

# Cloudinary Integration (Optional)
# If left empty, the system will fall back to local mock storage
CLOUDINARY_URL=
